#!/usr/bin/env bash
# Managed by Steam Deck Bluetooth Audio Multicast
set -euo pipefail

app=steam-deck-bluetooth-audio
unit="$app.service"
app_dir="$HOME/.local/share/$app"

case "${1:-}" in
    start|stop|restart)
        if [[ -z "${XDG_RUNTIME_DIR:-}" || ! -d "$XDG_RUNTIME_DIR" ]]; then
            echo "Open Konsole in Desktop Mode and run the command again." >&2
            exit 1
        fi
        exec 9<"$XDG_RUNTIME_DIR"
        flock -x 9
        ;;
esac

case "${1:-}" in
    start)
        systemctl --user enable --now "$unit"
        ;;
    stop)
        systemctl --user disable --now "$unit"
        "$app_dir/deck_audio.py" cleanup
        ;;
    restart)
        systemctl --user enable "$unit"
        systemctl --user restart "$unit"
        ;;
    status)
        if systemctl --user is-active --quiet "$unit"; then
            echo "The service is running."
        else
            echo "The service is stopped or restarting."
        fi
        printf 'Automatic startup: '
        systemctl --user is-enabled "$unit" || true
        "$app_dir/deck_audio.py" status
        ;;
    uninstall)
        exec "$app_dir/uninstall.sh"
        ;;
    *)
        echo "Usage: $app {start|stop|status|restart|uninstall}" >&2
        exit 2
        ;;
esac
